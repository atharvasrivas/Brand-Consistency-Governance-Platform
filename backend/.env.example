# Copy to .env. Never commit .env. All keys stay on the server.
PORT=5000
# Comma-separated origins allowed to call the API (your Vercel domain + local dev).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# demo = prototype identity from X-User-* headers set by the onboarding screen (NOT secure authentication)
# jwt  = require a Supabase Auth access token (Authorization: Bearer ...); role from app_metadata.brand_role
AUTH_MODE=demo
SUPABASE_JWT_SECRET=

# Storage: sqlite (default, zero setup) or supabase
STORE=sqlite
SQLITE_PATH=brandgov.db
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional AI layer. Without a key the rule engine alone runs and everything still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# generate_content (default) or interactions
GEMINI_API_STYLE=generate_content
GEMINI_TIMEOUT=20
GEMINI_IMAGE_TIMEOUT=45
# Retries for HTTP 429/503 only
GEMINI_RETRIES=1

# Owners can load a clearly labelled sample brand (set 0 to disable)
ALLOW_DEMO_DATA=1
